# Public Environment Configuration
# Copy this file to .env.local for local overrides.
# NOTE: Never store private API keys, email credentials, or database secrets in client-side environment variables.

# Production domain URL for canonical SEO
VITE_SITE_URL=https://nexoratech.io

# Optional Backend Endpoint for Project Enquiries (CRM / Formspree / Serverless webhook)
# If empty, the application runs in truthful demo mode with client validation.
VITE_ENQUIRY_API_ENDPOINT=

# Contact display email
VITE_CONTACT_EMAIL=contact@nexoratech.io
